{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "1) Run unit tests",
      "request": "launch",
      "mainClass": "logmon.TestRunner",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "java",
      "name": "2) Demo: sample_server.log (mixed errors)",
